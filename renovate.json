{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests"
    ],
    "platformAutomerge": true,
    "pre-commit": {
        "enabled": true
    },
    "enabledManagers": [
        "github-actions",
        "pre-commit",
        "terraform",
        "custom.regex"
    ],
    "terraform": {
        "managerFilePatterns": [
            "/^/terraform/.*\\.tf$/"
        ]
    },
    "prHourlyLimit": 20,
    "prConcurrentLimit": 20,
    "labels": [
        "dependencies",
        "renovate"
    ],
    "packageRules": [
        {
            "matchDatasources": [
                "aws-eks-addon"
            ],
            "minimumReleaseAge": "10 days"
        },
        {
            "matchManagers": [
                "custom.regex"
            ],
            "matchDepNames": [
                "Terraform Version"
            ],
            "groupName": "Terraform Version",
            "minimumReleaseAge": "10 days"
        },
        {
            "matchManagers": [
                "terraform"
            ],
            "matchDepTypes": [
                "required_version"
            ],
            "rangeStrategy": "bump",
            "groupName": "Terraform required_version",
            "minimumReleaseAge": "10 days"
        },
        {
          "matchPackageNames": ["alphagov/govuk-infrastructure"],
          "matchDepTypes": ["action"],
          "enabled": false
        },
        {
            "description": "Hold the argo-cd chart on the Argo CD 3.4 line. Chart 10.2.3+ ships Argo CD 3.5+, which only bundles Helm 4. Remove when ready for Helm 4.",
            "matchDatasources": [
                "helm"
            ],
            "matchPackageNames": [
                "argo-cd"
            ],
            "allowedVersions": "<10.2.3"
        },
        {
            "description": "Keep the Argo CD image (set via global.image.tag in argo.tf) on v3.4.x, which still bundles Helm 3. Remove when ready for Helm 4.",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "quay.io/argoproj/argocd"
            ],
            "allowedVersions": "/^v3\\.4\\.\\d+$/",
            "minimumReleaseAge": "10 days"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/.*cluster-infrastructure\\/main\\.tf/"
            ],
            "matchStrings": [
                "(?<depName>kube-proxy|metrics-server|vpc-cni|coredns|kube-state-metrics)\\s+=\\s+\\{\\s+addon_version\\s+=\\s+\"(?<currentValue>[a-zA-Z0-9-_.]+)\""
            ],
            "packageNameTemplate": "{\"kubernetesVersion\": \"1.36\", \"addonName\": \"{{depName}}\", \"region\": \"eu-west-1\"}",
            "depNameTemplate": "{{depName}}",
            "datasourceTemplate": "aws-eks-addon",
            "versioningTemplate": "aws-eks-addon"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/.*tfc-configuration\\/variables\\.tf/",
                "/.*ws\\/variables\\.tf/"
            ],
            "matchStrings": [
                "default\\s+=\\s+\"~>\\s+(?<currentValue>[0-9.]+)\""
            ],
            "packageNameTemplate": "hashicorp/terraform",
            "depNameTemplate": "Terraform Version",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/.*cluster-services\\/logging\\.tf/"
            ],
            "matchStrings": [
                "imageTag\\s+=\\s+\"(?<currentValue>[0-9.]+)\""
            ],
            "datasourceTemplate": "docker",
            "depNameTemplate": "elastic/filebeat"
        },
        {
            "description": "Argo CD image tag pinned in the argo-cd helm_release values.",
            "customType": "regex",
            "managerFilePatterns": [
                "/.*cluster-services\\/argo\\.tf/"
            ],
            "matchStrings": [
                "repository\\s+=\\s+\"(?<depName>quay\\.io\\/argoproj\\/argocd)\"\\s+tag\\s+=\\s+\"(?<currentValue>v[0-9.]+)\""
            ],
            "datasourceTemplate": "docker"
        }
    ]
}
